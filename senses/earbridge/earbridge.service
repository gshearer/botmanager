# earbridge.service — the robot's ear (RCH-5).
#
# ⚠ This is a SYSTEM unit that installs ON THE ROBOT, not on the botman host.
# It is the only systemd unit in this project that does. Install it with the
# commands deploy.sh prints (operator gate G4):
#
#   sudo cp ~/earbridge/earbridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now earbridge
#
# It runs as `pollen`, the same unprivileged user as the Reachy daemon, which
# is all the access it needs: capture goes through the shared dsnoop PCM in
# ~pollen/.asoundrc. It never calls /api/media/release and never opens hw:0,0,
# so the robot daemon keeps the microphone, and face tracking and DoA carry on
# untouched while this records.
#
# NO AUTHENTICATION. It will hand a recording of the room to anyone who asks
# on port 8090. That is acceptable only because the robot is on an isolated
# VLAN with botman as its sole client — revisit this the moment either
# changes.
#
# --take selects which channel of the 2-channel dsnoop stream becomes the mono
# utterance. The bake-off was run on 2026-08-03 and settled objectively rather
# than by ear: over a 6 s shared capture the two channels are BIT-IDENTICAL
# (rms(ch0-ch1) == 0.0 exactly). The XVF3800 emits one AEC/beamformed mono
# signal duplicated across both channels, so ch0, ch1 and mix produce
# byte-for-byte the same audio and there is nothing to choose between them.
#
# ch0 is therefore the flag, and --take is currently a no-op kept as the
# diagnostic for the day a firmware or .asoundrc change makes the channels
# differ. If you are here because audio looks wrong, re-run that comparison
# before assuming the channel is the problem.

[Unit]
Description=earbridge — microphone bridge for botman (reachy senses)
After=network-online.target reachy-mini-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=pollen
WorkingDirectory=/home/pollen/earbridge
# --floor-db and --hang-ms are the two knobs worth tuning, so both are spelled
# out here rather than left to the compiled defaults. Both were settled against
# measurements on 2026-08-06; the procedure that produced them is
# `scripts/reachy_mic_probe.sh`, which prints a floor ladder telling you what
# earbridge WOULD have published from a capture.
#
# --floor-db: earbridge measures the loudest 250 ms of each utterance and drops
# anything below this. -35 SURVIVED a two-capture ladder and should stay.
#   silence, 60 s, ceiling fan on : 10th pct -54.9 dBFS, ZERO events at every
#                                   floor tested, down to -45.
#   speech,  30 s, normal voice   : typical -20..-30, loudest 0.5 s -19.0,
#                                   dies entirely between -20 and -15.
# So the usable band is -45..-25 — but only for ONE speaker beside the robot.
# The room is 30x20 ft, and a speaker at 3x the distance loses ~9.5 dB to
# inverse-square, putting a normal voice near -33.5. RAISING THIS PAST -30
# DELETES EVERYONE ACROSS THE ROOM, to reject noise the silence capture says
# is not there. Do not "reduce sensitivity" here: every false positive ever
# identified on this robot (a cough at -11.7, a laptop beep at -20.0, TV
# dialogue at speech level) sits ABOVE any floor speech can survive. That is
# an attention-gate problem, not a floor problem.
#   real speech being dropped -> LOWER it (more negative), e.g. -40
#   -90 or below disables the gate entirely.
#
# --hang-ms: silence that ends an utterance. 700 was SPLITTING NATURAL SPEECH.
# Measured: 30 s of continuous talk holds 25 internal pauses, four of them
# over 700 ms (940, 900, 740, 720). The split orphans the vocative — "Mini,
# <pause> tell me a story" closed on the name, whisper got one context-free
# word and wrote "Many", and a homophone was added to attention.names to patch
# it. Proven live 2026-08-06/07 on the same voice and phrase, old binary vs
# new: voiced content per utterance went from [1960,1700,560,560,1580,300,500,
# 440] to [1840,1960,5160,1660,1520,1580,1940,1720,1820] — fragmentation
# 5/8 -> 0/9. ⚠ The cost is real and was seen once: the 5160 ms outlier is
# ~3 phrases merged, because the next was spoken within the hang. A longer
# hang merges speakers who overlap; raising it further trades that against
# +latency on every reply.
ExecStart=/home/pollen/earbridge/earbridge --daemon-url http://127.0.0.1:8000 --take ch0 --hang-ms 1100 --floor-db -35
# The capture thread already recovers from ALSA errors and reopens the device
# on its own; Restart is the backstop for something worse, not the strategy.
Restart=always
RestartSec=5
SyslogIdentifier=earbridge

[Install]
WantedBy=multi-user.target
